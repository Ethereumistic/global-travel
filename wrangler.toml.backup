#:schema node_modules/wrangler/config-schema.json
name = "global-travel"
compatibility_date = "2024-04-03"
compatibility_flags = ["nodejs_compat"]
pages_build_output_dir = ".vercel/output/static"

[[routes]]
pattern = "global-travel.bg/*"
zone_name = "https://global-travel.badjarovv.workers.dev"

[vars]
NEXT_PUBLIC_BASE_URL = "https://global-travel.badjarovv.workers.dev"
